{
  "name": "@tde.io/plexis",
  "version": "1.0.2",
  "description": "Zero-dependency TypeScript library for domain state machines and finite workflow pipelines",
  "license": "Apache-2.0",
  "author": "Claudio Nunez Jr",
  "repository": {
    "type": "git",
    "url": "https://github.com/claudio-darkkenergy/plexis.git"
  },
  "bugs": {
    "url": "https://github.com/claudio-darkkenergy/plexis/issues"
  },
  "homepage": "https://github.com/claudio-darkkenergy/plexis#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": "24"
  },
  "keywords": [
    "state-machine",
    "pipeline",
    "workflow",
    "typescript",
    "zero-dependency"
  ],
  "scripts": {
    "build": "rolldown -c && tsc -p tsconfig.types.json",
    "build:esm": "FORMAT=esm rolldown -c",
    "build:cjs": "FORMAT=cjs rolldown -c",
    "build:types": "tsc -p tsconfig.types.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example:payment": "tsx examples/payment-pipeline.ts",
    "example:order": "tsx examples/order-domain.ts",
    "example:graph": "tsx examples/graph-inspection.ts",
    "dev": "vite examples",
    "just-patch": "npm version patch --no-git-tag-version"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "rolldown": "^1.0.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.3.0"
}
